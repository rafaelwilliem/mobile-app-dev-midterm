<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Notification & Service Permissions -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_task_list"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DailyPlanner">

        <!-- Main Activity with Bottom Navigation and Fragments -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Add Task Activity -->
        <activity
            android:name=".AddTaskActivity"
            android:exported="false"
            android:label="@string/title_add_task"
            android:parentActivityName=".MainActivity" />

        <!-- Background Service for Focus Timer -->
        <service
            android:name=".service.FocusTimerService"
            android:enabled="true"
            android:exported="false" />

    </application>

</manifest>
